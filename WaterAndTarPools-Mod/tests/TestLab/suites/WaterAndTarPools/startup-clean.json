{
    "name":  "startup-clean",
    "description":  "The mod\u0027s own InGameTests pass in a TestLab world and nothing logged an error",
    "timeout":  60,
    "steps":  [
                  {
                      "do":  "hook",
                      "name":  "waterandtarpools.arena",
                      "label":  "start on the arena spot",
                      "contains":  "arena at"
                  },
                  {
                      "do":  "wait",
                      "seconds":  6
                  },
                  {
                      "do":  "hook",
                      "name":  "waterandtarpools.selftest",
                      "label":  "InGameTests",
                      "notContains":  "FAIL",
                      "contains":  "PASS"
                  }
              ],
    "asserts":  [
                    {
                        "check":  "noErrors",
                        "source":  "WaterAndTarPools"
                    }
                ]
}